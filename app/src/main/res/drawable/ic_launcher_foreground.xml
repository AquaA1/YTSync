<?xml version="1.0" encoding="utf-8"?>
<!--
    Foreground layer of the adaptive launcher icon.
    A simple white music-note triangle (play button) centred in the 108dp canvas.
    The safe zone is the inner 72dp; artwork is kept well within it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- White play-button triangle -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M40,30 L40,78 L78,54 Z" />
</vector>
